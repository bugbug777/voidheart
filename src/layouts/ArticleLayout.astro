---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { formatDate, getReadingTime } from "../utils/blog";
import { withBase } from "../utils/urls";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  body: string;
  TOC?: boolean;
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  body,
  TOC = false,
  headings = [],
} = Astro.props;
const showToc = TOC && headings.some((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<BaseLayout title={title} description={description}>
  <div class:list={["article-shell", { "article-shell--with-toc": showToc }]}>
    {showToc && (
      <aside class="article-toc" aria-label="文章目錄側欄">
        <TableOfContents headings={headings} />
      </aside>
    )}
    <article class="article-main">
      <header class="article-header">
        <p class="eyebrow">Void Heart / Article</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <span>更新於 {formatDate(updatedDate)}</span>}
          <span>{getReadingTime(body)}</span>
        </div>
        <ul class="tag-list" aria-label="文章標籤">
          {tags.map((tag) => <li><a class="tag" href={withBase(`/tags/${tag}/`)}>#{tag}</a></li>)}
        </ul>
      </header>
      {showToc && (
        <div class="article-toc-mobile">
          <TableOfContents headings={headings} />
        </div>
      )}
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
