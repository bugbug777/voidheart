---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getAllTags, getPostsByTag, getPublishedPosts } from "../../utils/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getAllTags(posts).map((tag) => ({
    params: { tag },
    props: { tag, posts: getPostsByTag(posts, tag) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Void Heart 中標籤為 ${tag} 的文章。`}>
  <section class="content-shell">
    <p class="eyebrow">Tag</p>
    <h1 class="page-title">#{tag}</h1>
    <p class="hero__copy">這個標籤下共有 {posts.length} 篇文章。</p>
  </section>
  <section class="content-shell section" aria-label={`${tag} 文章列表`}>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
